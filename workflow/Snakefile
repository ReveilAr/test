"""
ATLAS-MS workflow.

Started by `atlas-ms run <project>` (or by the app), which calls

    snakemake --snakefile <repo>/workflow/Snakefile --directory <project>
              --configfile <project>/project.yaml --cores N --sdm conda

so every path below is relative to the project folder. The logic lives in
the `atlas_ms` package; each rule only wires files and parameters to it.

Multi-run steps list the runs in the order of samples.tsv: that order is
the OpenMS "map index" everywhere (consensus columns, GNPS export...).
"""

import re

from atlas_ms.config import ProjectConfig
from atlas_ms.project import raw_format, read_samples

# Parameters and samples. Both are validated here, so a mistake in
# project.yaml or samples.tsv stops the run before any processing.
CFG = ProjectConfig.from_dict(config)
SAMPLES = read_samples("samples.tsv")
NAMES = list(SAMPLES.index)


def names_regex(names):
    """Regex matching exactly these sample names (or nothing, if empty)."""
    return "|".join(re.escape(name) for name in names) or "(?!x)x"


# Threads of a step that processes one run: the runs share the cores (4 runs
# on 16 cores: 4 threads each; 100 runs: 1 each). pyOpenMS uses them through
# OpenMP (see the rule scripts).
RUN_THREADS = max(1, workflow.cores // max(1, len(NAMES)))


def run_memory_mb(wildcards, input):
    """
    Memory estimate (MB) of a step that loads a whole run with pyOpenMS:
    about 4 times the mzML file, plus 500 MB. With `--resources mem_mb=...`
    (set by atlas-ms run and the app), Snakemake then starts only as many
    runs at once as fit in memory.
    """
    return int(500 + 4 * input.size_mb)


# Sample names grouped by raw file format: decides the conversion rule.
THERMO = names_regex([n for n in NAMES if raw_format(SAMPLES.loc[n, "file"]) == "thermo"])
MZML = names_regex([n for n in NAMES if raw_format(SAMPLES.loc[n, "file"]) == "mzml"])

wildcard_constraints:
    sample=names_regex(NAMES),

# Final outputs of the workflow.
RESULTS = {
    "features": "results/features.parquet",
    "quant": "results/quant.parquet",
    "quant_gap_filled": "results/quant_gap_filled.parquet",
    "mgf": "results/gnps/ms2_spectra.mgf",
    "gnps_quant": "results/gnps/quantification_table.txt",
    "gnps_metadata": "results/gnps/metadata.tsv",
    "gnps_pairs": "results/gnps/iimn_supplementary_pairs.csv",
    "nodes": "results/network/nodes.parquet",
    "edges": "results/network/edges.parquet",
    "graphml": "results/network/network.graphml",
    "library_annotations": "results/annotations/library.parquet",
    "lipid_annotations": "results/annotations/lipid_rules.parquet",
    "candidates": "results/annotations/candidates.parquet",
    "best": "results/annotations/best.parquet",
}


rule all:
    input:
        RESULTS.values(),


include: "rules/conversion.smk"
include: "rules/preprocessing.smk"
include: "rules/gap_filling.smk"
include: "rules/export.smk"
include: "rules/network.smk"
include: "rules/annotation.smk"
